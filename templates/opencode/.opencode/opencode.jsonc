{
  "$schema": "https://opencode.ai/config.json",
  // 진입 doc 공통 코어 + opencode-고유 운영 지침 로드. AGENTS.md(harness-neutral
  // 공통 코어)는 opencode 가 자동 로드하고, opencode-고유 실행 모델·위임 규약은 pm-instructions.md 로
  // 이관해 이 `instructions` 배열로 함께 로드한다 — 둘이 합쳐 PM 운영 매뉴얼이 된다. pm-instructions.md
  // 는 @source 전파 등록(engine.manifest)이라 방법론 갱신이 pm_update 로 채택자에 도달한다(instance-owned
  // AGENTS.md 와 대비). 채택자는 자기 지침을 추가하려면 이 배열에 경로를 덧붙인다.
  "instructions": [
    ".opencode/pm-instructions.md"
  ],
  // ctx checkpoint 가드 & 자동 컴팩션: 자동 컴팩션 기본값(켜짐)을 유지한다(`compaction.auto` 를 두지
  // 않는다). 컨텍스트 한계 대응 모델이 "압축은 허용하고 서사를 미리 기록" 이기 때문이다 — 정상 경로는
  // 사전 checkpoint 경고 → native compaction → 사후 checkpoint 안내이고, plugin 이 `session.compacted`
  // 를 관측해 구간 경고를 다시 켠다(경고는 압축 사이클당 1회).
  // ctx-guard 구간(사용 한도 대비 쓴 `ctx.checkpoint_at_pct`/`ctx.precompact_at_pct` = 기본 70/80)은 전부
  //   **비차단 안내**다. 최종 구간도 마지막 checkpoint 경고로만 소비하고 prompt·도구·compaction 을
  //   막지 않는다. plugin 산출은 안내문 3종(경고·2단 강한 경고·압축 후 안내)뿐이며 핸드오프를 트리거하지
  //   않는다. 세션을 실제로 교체하는 회전은 relay driver 경로가 담당한다(pm_orch_opencode.py·이 plugin 아님).
  // 전역 자동 컴팩션을 끄면 안 된다: native task 가 만든 자식 세션은 checkpoint 안내를 면제받으므로
  // (Claude sub-session 등가 정책) 자동 컴팩션이 유일한 생존 기제다 — 꺼두면 위임 서브에이전트가
  // 압축도 안내도 없이 컨텍스트 초과로 죽는다. agent 별 compaction 토글은 현재 config 스키마에
  // 없으므로(per-agent 미지원) "전역 기본 켜짐 + PM 은 압축 전 checkpoint 기록" 이 둘 다 지키는 조합이다.
  // 압축 지점(관리 키): 프레임워크가 local.conf 의 opencode 사용 한도(`harness.opencode.ctx_window_tokens`)
  //   와 압축 비율(`ctx.compact_at_pct`)로 최상위 `compaction.reserved`(= 적용 한도 − 압축 지점)와 모델
  //   항목의 `limit.input`(= 적용 한도)을 쓴다. 값은 local.conf 에서 고친다(pm-update·pm-config apply 가
  //   다시 쓴다). 적용 한도는 사용 한도와 대상 모델 가용 한도 가운데 가장 작은 값이다. opencode 는
  //   min(`limit.input`, `limit.context`) − `compaction.reserved` 에서 압축한다.
  // (토큰추적·경고·checkpoint 안내는 .opencode/plugins/ctx-guard.js 가 autoload 로 담당 — 차단 없음.)
  "compaction": {
    "reserved": 20000
  },
  // 모델 한도: `limit.context` 는 모델 창, `limit.output` 은 한 요청에 청하는 출력 상한이다(opencode 는
  //   min(limit.output, 256000) 을 청하고 값이 없으면 32000 을 쓴다). 프레임워크는 두 값으로 그 모델의 가용
  //   한도(limit.context − 출력 상한)를 계산하고 두 값을 쓰지도 지우지도 않는다. 채택자는 자기
  //   provider/model 에 맞춰 아래 엔트리를 조정한다. 이 파일과 opencode 전역 설정에 적힌 모델 가운데
  //   opencode 모델 목록에 있는 모델마다 프레임워크가 이 파일에 `limit.input` 을 쓴다(전역 설정에만
  //   적힌 모델도 여기에 항목이 생긴다).
  "provider": {
    "ollama": {
      "models": {
        "glm-5.3:cloud": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 32768
          }
        }
      }
    }
  },
  // 서브에이전트(task)·도구 출력 절단 상향 (라이브 실증): opencode 전역 tool_output
  // 기본(max_lines=2000·max_bytes=51200[50KB])이 task 반환도 절단해, researcher/reviewer 의 큰
  // 보고가 PM 에 온전히 도달하지 못했다. 상한을 올려 큰 서브에이전트 보고를 통과시키되, runaway
  // 출력이 context 를 범람하지 않게 무한이 아닌 적정 상한(12000줄·512KB)을 둔다 — PM 세션은
  // ctx-guard 가 압축 전 checkpoint 기록을 유도하고, 자식 세션은 자동 컴팩션이 생존을 맡는다.
  // 실사용 보고 크기 보고 조정 가능.
  "tool_output": {
    "max_lines": 12000,
    "max_bytes": 524288
  },
  // 위험 bash 명령 기본 가드 (claude 어댑터 .claude/settings.json deny 미러링 + opencode 추가).
  // 단일 진실 = 이 project config. agents/*.md 도 같은 패턴맵을 명시(coarse "allow"
  // override 차단 — opencode 는 permission 을 룰 리스트로 평탄화·누적하므로 agent 가
  // bash: "allow" 만 주면 deny 룰 뒤에 allow * 가 append 돼 매칭 규칙에 따라 우회될 수
  // 있다. agents 도 패턴맵으로 명시하면 어떤 매칭 규칙에서도 deny 가 마지막에 보존된다).
  // 채택자는 프로젝트에서 이 가드를 완화할 수 있다 (deny → ask/allow).
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git clean -f*": "deny",
      "git reset --hard*": "ask"
    }
  }
}
