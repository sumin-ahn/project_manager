# pm-retired-path: .project_manager/tools/repo_coordinates.py -> .project_manager/tools/pm_engine/infra/repo_coordinates.py
# pm-retired-path: .project_manager/tools/pm_relay.py -> .project_manager/tools/pm_engine/app/session/relay.py
# pm-retired-path: .project_manager/tools/review_rounds.py -> .project_manager/tools/pm_engine/infra/review_rounds.py
# pm-retired-path: .project_manager/tools/ticket_rounds.py -> .project_manager/tools/pm_engine/domain/round_rules.py
.project_manager/tools/board.py
# engine_rev: 엔진 사본 rev 스탬프 단일 진실 — sibling 로더가 로드한 형제 모듈의
#   ENGINE_REV 를 이 값과 대조해 사본 skew(신 도구+구 형제)를 로드 시점 fail-loud 로 표출.
#   신설 도구라 등록 필수(미등록=전파 안 됨·pm_render 사례). 릴리즈 bump 유일 지점.
.project_manager/tools/engine_rev.py
# python_floor: 실제 `py <script>` shebang 디스패치와 동형인 Python 3.11 하한 probe.
.project_manager/tools/python_floor.py
# domain: v2 도메인 지식 레이어 엔진 (covers 파서·touches∩covers·staleness·freshness lint·capture). domain/ 페이지는 인스턴스 소유(manifest 밖)
.project_manager/tools/domain.py
.project_manager/tools/pm_bootstrap.py
.project_manager/tools/pm_handoff.py
.project_manager/tools/pm_log.py
.project_manager/tools/ticket_finish.py
.project_manager/tools/pm_update.py
# pm_import: 채택자 홈 생성/임베드 import 엔진. manifest 편입→ pm_update 전파로 채택자 사본 stale 해소. 비-@render·verbatim copy2(tools/* 토큰치환 제외). manifest 진화(새 항목이 기존 채택자에 도달)는 pm-update 스킬 reconcile(self-list 아님·codex)
.project_manager/tools/pm_import.py
# pm_render: 어댑터 render 엔진 (operational 토큰 치환). pm_update/pm_import 가 @render path 에 위임. 도구 전파 등록일 뿐 — @render *활성화*는 별도 결정
.project_manager/tools/pm_render.py
# additional_reviewer: 추가 리뷰어 어댑터 (기본 OFF). review_context.local.md·local.conf 는 인스턴스 소유(manifest 밖)
.project_manager/tools/additional_reviewer.py
# pm-retired-path: .project_manager/tools/external_review.py -> .project_manager/tools/additional_reviewer.py
# pm-retired-path: .project_manager/tools/gate_snapshot.py -> .project_manager/tools/pm_delegate.py
# pm-retired-path: .claude/precompact_capture_hook.sh -> .project_manager/tools/pm_log.py
# worktree_pool: repo별 worktree 풀 리스 엔진 (multi-PM 모델). 순수 엔진(git DI seam)
.project_manager/tools/worktree_pool.py
# pm_config: multi-PM 셋업/관리 파사드 디스패처. 루트 forwarder pm-config.sh/.cmd 는
#   per-harness 템플릿 트리(templates/<harness>/)에 두고 pm_import 가 채택자 루트로 복사(pm-update.sh/.cmd 동형·manifest 밖)
.project_manager/tools/pm_config.py
# local_conf: CLI 진입 파일(--keys·--keys --json·--render-adapter-block), 구현은 pm_engine
#   (domain/conf_schema·infra/conf_store·cli/local_conf). 관리자가 프로젝트 사본마다 `--keys --json` 으로
#   부른다.
.project_manager/tools/local_conf.py
# delegate_channel_guard: claude PreToolUse(Agent) 위임 채널 가드 — local.conf delegate 매핑 불일치 시 deny·자체 고장 fail-open. 래퍼 delegate_channel_guard_hook.sh 는 claude 어댑터층(ADAPTER_HOOK_SET)
.project_manager/tools/delegate_channel_guard.py
# delegate_scope: 위임 전/후 porcelain 상태를 비교해 ticket touches 밖 변경을 loud 경고로
#   표면화하는 비차단 판정기. PM-home 좌표는 repo_coordinates 공용 normalizer를 재사용.
.project_manager/tools/delegate_scope.py
# pm_adr: ADR 발행/개정 명령어化 backbone (4요소 스키마·lifecycle). 채번·frontmatter
#   scaffold·개정 대상 back-ref 기록·README 색인·log decide entry 원자화. 신설 도구라 등록 필수
#   (미등록=전파 안 됨·pm_render 사례). ADR 실경로는 인스턴스 소유(decisions/·manifest 밖·self-location 해소)
.project_manager/tools/pm_adr.py
# contradiction_lint: 모순 lint — 결정 개정(amends/supersedes) 시점에 옛 결정을
#   참조하는 문서의 잔여 모순 후보를 표면화(탐지 LLM DI·기본 dry / 판정 사람·advisory).
#   pm_adr.py 발행 명령이 트리거로 호출(개정에만 발화).
.project_manager/tools/contradiction_lint.py
# pm_delegate: cross-harness 역할 위임 채널 (기본 OFF·delegate.enabled opt-in). 신설 도구라
#   등록 필수(미등록=전파 안 됨). local.conf delegate.* 매핑은 인스턴스 소유(manifest 밖)
.project_manager/tools/pm_delegate.py
# private_refs: 사설 참조 판정식 공용 seam — 출하 산문(주석·문서 표현식)에서 사설 작업-항목
#   참조를 기계 판정하고, 출하 표면(python·markdown)을 repo-owned 열거에서 분류한다
#   (`shipping_paths`). 스트립 도구(scripts/)와 재유입 가드가 같은 한 벌을 소비해야 판정이
#   갈리지 않으므로 엔진에 둔다. 신설 도구라 등록 필수(미등록=전파 안 됨·pm_render 사례).
.project_manager/tools/private_refs.py
# pm_principles: 판단 원칙 레지스트리 로더 + recall 판정. 출하층 `wiki/pm_principles.md`
#   와 PM 홈 로컬층 `wiki/pm_principles.local.md`(미출하·manifest 미등재)를 합성해 세 어댑터가
#   공유하는 `judge_recall` 하나로 판정한다. stdlib-only. 신설 도구라 등록 필수(미등록=전파 안 됨).
.project_manager/tools/pm_principles.py

# ── 방법론 문서 (엔진 · 프로젝트별 칸은 *.local.md / local.conf, manifest 밖) ──
