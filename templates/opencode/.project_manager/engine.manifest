# engine.manifest (opencode 타깃) — upstream(프레임워크) 소유 경로.
# `pm_update.py` 가 이 경로만 덮어쓴다(merge 아님).
# 여기 없는 건 인스턴스 소유(상태: tickets/·status·log·decisions/*.md·areas.md…) 또는 per-clone
# 로컬(board.md·pm_state·local.conf·.local) — pm_update 가 절대 건드리지 않음.
# 한 줄 = 한 경로(파일/디렉토리), repo 루트 기준. '#' 주석. 디렉토리는 재귀 동기화.
#
# claude_code 타깃 대비 차이:
#   - .claude/agents 제외 (opencode 는 agent 정의를 .opencode/agents 로 가진다 — T-0002~T-0004)
#   - .claude/skills 스킬 채널과 .opencode/command 사람 슬래시 진입 채널을 둘 다 출하한다.
#     canonical 은 root `.claude/skills/*/SKILL.md` 하나이며 command 파일은 각 canonical 파일에서
#     @source 리맵으로 기계 생성한다(T-0674·ADR-0065 개정 대기). 스킬은 모델 `skill` tool 소비,
#     command는 팔레트 `/pm-…` 사람 진입이며 두 표면은 서로 대체 관계가 아니다.
#   - 어댑터 파일(.opencode/agents·lib·plugins·AGENTS.md)은 opencode-고유 어댑터층으로 잔존.

# ── 도구 (순수 엔진) ─────────────────────────────────────────────
.project_manager/tools/board.py
# engine_rev: 엔진 사본 rev 스탬프 단일 진실 (T-0397) — sibling 로더가 로드한 형제 모듈의
#   ENGINE_REV 를 이 값과 대조해 사본 skew(신 도구+구 형제)를 로드 시점 fail-loud 로 표출.
#   신설 도구라 등록 필수(미등록=전파 안 됨·pm_render 사례). 릴리즈 bump 유일 지점.
.project_manager/tools/engine_rev.py
# python_floor: 실제 `py <script>` shebang 디스패치와 동형인 Python 3.11 하한 probe.
.project_manager/tools/python_floor.py
# console_encoding: 전 CLI 공용 Windows codepage 65001 + UTF-8 스트림 부트스트랩(T-0481).
#   신규 __main__ 진입점도 정적 전수 가드가 이 helper 호출을 강제한다.
.project_manager/tools/console_encoding.py
# domain: v2 도메인 지식 레이어 엔진 (ADR-0018·covers 파서·touches∩covers·staleness·freshness lint·capture). domain/ 페이지는 인스턴스 소유(manifest 밖)
.project_manager/tools/domain.py
.project_manager/tools/pm_bootstrap.py
.project_manager/tools/pm_handoff.py
.project_manager/tools/pm_log.py
.project_manager/tools/ticket_finish.py
.project_manager/tools/pm_update.py
# pm_import: 채택자 홈 생성/임베드 import 엔진 (ADR-0027). manifest 편입(T-0140·ADR-0032) → pm_update 전파로 PM 31 ⓒ stale 해소. 비-@render·verbatim copy2(tools/* 토큰치환 제외). manifest 진화(새 항목이 기존 채택자에 도달)는 pm-update 스킬 reconcile(T-0142·self-list 아님·codex)
.project_manager/tools/pm_import.py
# pm_render: 어댑터 render 엔진 (ADR-0028·ADR-0031·operational 토큰 치환). pm_update/pm_import 가 @render path 에 위임. 도구 전파 등록일 뿐 — @render *활성화*는 T-0133(D17)
.project_manager/tools/pm_render.py
# relay core: 하니스 무관 thin stateless supervisor (ADR-0009). 하니스 driver(pm_orch_*.py)는 어댑터층(manifest 밖)
.project_manager/tools/pm_relay.py
# external_review: 추가 리뷰어 어댑터 (ADR-0004·기본 OFF). review_context.local.md·local.conf 는 인스턴스 소유(manifest 밖)
.project_manager/tools/external_review.py
.project_manager/tools/review_rounds.py
# ticket_rounds: 티켓 명세 파일 옆 라운드 사이드카(tickets/rounds/<id>/NN-<role>.md) 공용 seam —
#   경로 규약·파일명 문법·티켓 전역 순번 배타 예약·로드/판정/렌더. 락과 보드 경로 해소는
#   호출자 소유(board 를 로드하지 않는다). 신설 도구라 등록 필수(미등록=전파 안 됨).
.project_manager/tools/ticket_rounds.py
.project_manager/tools/gate_snapshot.py
# worktree_pool: repo별 worktree 풀 리스 엔진 (ADR-0013·multi-PM 모델). 순수 엔진(git DI seam)
.project_manager/tools/worktree_pool.py
# pm_config: multi-PM 셋업/관리 파사드 디스패처 (ADR-0011·0014). 루트 forwarder pm-config.sh/.cmd 는
#   per-harness 템플릿 트리(templates/<harness>/)에 두고 pm_import 가 채택자 루트로 복사(pm-update.sh/.cmd 동형·manifest 밖)
.project_manager/tools/pm_config.py
# identity_args: 공용 정체성 인자 모듈 — --repo/--slot 파싱(discriminated) + 리스(활성슬롯) 읽기·해소
#   단일 진실(ADR-0057·B-1). 전 CLI 순차 채택(T-0314/0315/0316/0317/0318) — 신설 도구라 등록 필수
#   (미등록=전파 안 됨·pm_render 사례).
.project_manager/tools/identity_args.py
# repo_coordinates: PM-home ticket touches(`work/<repo>_<N>/...`)를 검증된 workspace/lease와
#   일치할 때만 소유-repo 상대 좌표로 바꾸는 공용 normalizer(T-0473). 불일치는 fail-loud.
.project_manager/tools/repo_coordinates.py
# repo_owned_files: git 우선 repo 소유 파일 열거 공용 seam. tracked_only/owned 모드를 선언한다.
#   owned는 git 실패 시 폴백, tracked_only는 비저장소(rc 128)/git 부재만 loud 경고 후 폴백하고
#   옵션 미지원(rc 129)·손상 index·unmerged는 누출 방지를 위해 실패한다.
.project_manager/tools/repo_owned_files.py
# file_lock: 배타 파일락 공용 seam (T-0561) — POSIX flock / Windows msvcrt / 무락 폴백 분기의
#   단일 구현. board(board.lock·board-git.lock)·pm_log(log.lock)·pm_relay(raw 장부 .lock)가
#   소비한다(락 파일 경로 규약은 각 도구 소유). 신설 도구라 등록 필수(미등록=전파 안 됨·pm_render 사례).
.project_manager/tools/file_lock.py
# local_conf: local.conf 파싱/구표기 판정 공용 seam — `KEY=value`·`#` 주석·중복키 last-wins·
#   미존재/IO 실패는 빈 맵. 구표기(flat) 키가 남아 있으면 소비 시점에 fail-loud 하고 키마다
#   신표기를 처방한다(pm_update/pm_import 의 파일 반영 경로만 비차단 안내). 소비자 9:
#   board·external_review·pm_delegate·pm_update·pm_import·pm_config·pm_bootstrap·ticket_finish·
#   pm_handoff. 신설 도구라 등록 필수(미등록=전파 안 됨·pm_render 사례).
.project_manager/tools/local_conf.py
# delegate_channel_guard: claude PreToolUse(Agent) 위임 채널 가드 — local.conf delegate 매핑 불일치 시 deny·자체 고장 fail-open (T-0633). 래퍼 delegate_channel_guard_hook.sh 는 claude 어댑터층(ADAPTER_HOOK_SET)
.project_manager/tools/delegate_channel_guard.py
# delegate_scope: 위임 전/후 porcelain 상태를 비교해 ticket touches 밖 변경을 loud 경고로
#   표면화하는 비차단 판정기(T-0462). PM-home 좌표는 repo_coordinates 공용 normalizer를 재사용.
.project_manager/tools/delegate_scope.py
# pm_adr: ADR 발행/개정 명령어化 backbone (ADR-0049 4요소·ADR-0021 lifecycle). 채번·frontmatter
#   scaffold·개정 대상 back-ref 기록·README 색인·log decide entry 원자화. 신설 도구라 등록 필수
#   (미등록=전파 안 됨·pm_render 사례). ADR 실경로는 인스턴스 소유(decisions/·manifest 밖·self-location 해소)
.project_manager/tools/pm_adr.py
# contradiction_lint: 모순 lint (ADR-0064·T-0369) — 결정 개정(amends/supersedes) 시점에 옛 결정을
#   참조하는 문서의 잔여 모순 후보를 표면화(탐지 LLM DI·기본 dry / 판정 사람·advisory).
#   pm_adr.py 발행 명령이 트리거로 호출(개정에만 발화).
.project_manager/tools/contradiction_lint.py
# pm_delegate: cross-harness 역할 위임 채널 (ADR-0075·기본 OFF·delegate.enabled opt-in). 신설 도구라
#   등록 필수(미등록=전파 안 됨). local.conf delegate.* 매핑은 인스턴스 소유(manifest 밖)
.project_manager/tools/pm_delegate.py
# private_refs: 사설 참조 판정식 공용 seam — 출하 산문(주석·문서 표현식)에서 사설 작업-항목
#   참조를 기계 판정하고, 출하 표면(python·markdown)을 repo-owned 열거에서 분류한다
#   (`shipping_paths`). 스트립 도구(scripts/)와 재유입 가드가 같은 한 벌을 소비해야 판정이
#   갈리지 않으므로 엔진에 둔다. 신설 도구라 등록 필수(미등록=전파 안 됨·pm_render 사례).
.project_manager/tools/private_refs.py
# pm_principles: 판단 원칙 레지스트리 로더 + recall 판정. 출하층 `wiki/pm_principles.md`
#   와 PM 홈 로컬층 `wiki/pm_principles.local.md`(미출하·manifest 미등재)를 합성해 세 어댑터가
#   공유하는 `judge_recall` 하나로 판정한다. stdlib-only. 신설 도구라 등록 필수(미등록=전파 안 됨).
.project_manager/tools/pm_principles.py

# ── 방법론 문서 (엔진 · 프로젝트별 칸은 *.local.md / local.conf, manifest 밖) ──
.project_manager/wiki/pm_role.md
.project_manager/wiki/pm_playbook.md
# pm_principles.md: 판단 원칙 레지스트리 출하층 — 위 로더가 파싱하는 기계 입력이자
#   사람이 읽는 문서. PM 홈 로컬층 `pm_principles.local.md` 는 의도적으로 미등재(인스턴스 소유).
.project_manager/wiki/pm_principles.md
