{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/templates/claude_code/.claude/ctx_stop_hook.sh --git-anchor-hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/precompact_capture_hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
